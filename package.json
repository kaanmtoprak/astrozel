{
  "name": "astrozel",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:lan": "next dev --hostname 0.0.0.0 --port 3100",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:mobile": "playwright test e2e/mobile-overlay-flow.spec.ts --project=mobile-chrome --project=mobile-webkit",
    "test:e2e:hydration": "playwright test e2e/hydration.spec.ts --project=chromium --project=mobile-chrome --project=mobile-webkit",
    "check:fast": "npm run lint && npm run build",
    "verify:production": "npm run test && npm run test:e2e && npm run test:e2e:mobile && npm run test:e2e:hydration && npm run lint && npm run build",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv ./cloudflare-env.d.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.6.0",
    "@js-temporal/polyfill": "^0.5.1",
    "@opennextjs/cloudflare": "^1.19.9",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "celestine": "^0.2.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.28.0",
    "next": "16.2.11",
    "pdfmake": "^0.3.11",
    "react": "^19.1.7",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.1.7",
    "react-hook-form": "^7.84.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.19.43",
    "@types/pdfmake": "^0.3.3",
    "@types/react": "^19.1.7",
    "@types/react-dom": "^19.1.7",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "tailwindcss": "^4",
    "typescript": "^5.7.4",
    "vitest": "^4.1.10",
    "wrangler": "^4.118.0"
  }
}
